# =============================================================================
# Fielito · Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# La app funciona sin configuración usando el modo demo (localStorage).
# =============================================================================

# URL pública de la app (usada en metadata y enlaces de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# QR antifraude
# Genera un secreto largo y aleatorio: openssl rand -hex 32
# -----------------------------------------------------------------------------
QR_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Stripe (modo test) — https://dashboard.stripe.com/test/apikeys
# En el MVP el checkout es simulado; estas variables preparan la integración real.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
